{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fantasy-music.local/schema/catalog.schema.json",
  "title": "FantasyMusicCatalog",
  "description": "Export figé du catalogue (séries, artistes, cartes, cliquet). Spec: docs/09-schema-donnees.md",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "series", "artists", "groups", "memberships", "plates", "cards", "rarity_events"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "series": {
      "type": "array",
      "items": { "$ref": "#/$defs/series" }
    },
    "artists": {
      "type": "array",
      "items": { "$ref": "#/$defs/artist" }
    },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/group" }
    },
    "memberships": {
      "type": "array",
      "items": { "$ref": "#/$defs/membership" }
    },
    "plates": {
      "type": "array",
      "items": { "$ref": "#/$defs/plate" }
    },
    "cards": {
      "type": "array",
      "items": { "$ref": "#/$defs/card" }
    },
    "rarity_events": {
      "type": "array",
      "items": { "$ref": "#/$defs/rarity_event" }
    }
  },
  "$defs": {
    "rarity": {
      "type": "string",
      "enum": ["commune", "argent", "or", "platine", "diamant"]
    },
    "sex": {
      "type": "string",
      "enum": ["f", "m", "x"]
    },
    "iso_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "size", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 1 },
        "released_at": {
          "oneOf": [{ "$ref": "#/$defs/iso_date" }, { "type": "null" }]
        },
        "status": {
          "type": "string",
          "enum": ["draft", "released", "archived"]
        }
      }
    },
    "artist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qid", "name"],
      "properties": {
        "qid": { "type": "string", "pattern": "^Q[0-9]+$" },
        "mbid": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            { "type": "null" }
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "sex": {
          "oneOf": [{ "$ref": "#/$defs/sex" }, { "type": "null" }]
        },
        "instrument": {
          "oneOf": [{ "type": "string" }, { "type": "null" }]
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mbid", "name"],
      "properties": {
        "mbid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "name": { "type": "string", "minLength": 1 },
        "qid": {
          "oneOf": [
            { "type": "string", "pattern": "^Q[0-9]+$" },
            { "type": "null" }
          ]
        }
      }
    },
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artist_qid", "group_mbid", "is_primary"],
      "properties": {
        "artist_qid": { "type": "string", "pattern": "^Q[0-9]+$" },
        "group_mbid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "start": {
          "oneOf": [{ "$ref": "#/$defs/iso_date" }, { "type": "null" }]
        },
        "end": {
          "oneOf": [{ "$ref": "#/$defs/iso_date" }, { "type": "null" }]
        },
        "is_primary": { "type": "boolean" }
      }
    },
    "plate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "style", "instrument", "pose", "costume", "venue", "sil"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "style": {
          "type": "string",
          "enum": ["serigraphie", "contrejour", "encre"]
        },
        "instrument": { "type": "string", "minLength": 1 },
        "pose": { "type": "integer", "minimum": 1, "maximum": 7 },
        "costume": { "type": "string", "minLength": 1 },
        "venue": { "type": "string", "minLength": 1 },
        "sil": { "$ref": "#/$defs/sex" },
        "path": {
          "oneOf": [{ "type": "string" }, { "type": "null" }]
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "series_id",
        "artist_qid",
        "rank_in_series",
        "rarity_initial",
        "rarity_current",
        "family",
        "band",
        "plate_id",
        "in_booster_pool"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^.+:Q[0-9]+$",
          "description": "{series_id}:{qid}"
        },
        "series_id": { "type": "string", "minLength": 1 },
        "artist_qid": { "type": "string", "pattern": "^Q[0-9]+$" },
        "rank_in_series": { "type": "integer", "minimum": 1 },
        "rank_vivier": {
          "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "rarity_initial": { "$ref": "#/$defs/rarity" },
        "rarity_current": { "$ref": "#/$defs/rarity" },
        "family": { "type": "string", "minLength": 1 },
        "band": { "type": "string", "minLength": 1 },
        "region": {
          "oneOf": [{ "type": "string" }, { "type": "null" }]
        },
        "era": {
          "oneOf": [{ "type": "string" }, { "type": "null" }]
        },
        "motif": {
          "oneOf": [{ "type": "string" }, { "type": "null" }]
        },
        "plate_id": { "type": "string", "minLength": 1 },
        "group_mbid": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            { "type": "null" }
          ]
        },
        "in_booster_pool": { "type": "boolean" }
      }
    },
    "rarity_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "from_rarity",
        "to_rarity",
        "series_boundary",
        "effective_at",
        "reason"
      ],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "card_id": { "type": "string", "minLength": 1 },
        "from_rarity": { "$ref": "#/$defs/rarity" },
        "to_rarity": { "$ref": "#/$defs/rarity" },
        "series_boundary": { "type": "string", "minLength": 1 },
        "effective_at": { "$ref": "#/$defs/iso_date" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
